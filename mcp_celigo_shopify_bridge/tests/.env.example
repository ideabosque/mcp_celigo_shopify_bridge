# Celigo integrator.io MCP endpoint credentials used by run_integration.py
# Copy to .env and fill in real values.
# Primary endpoint: UCP-conforming Shopify catalog tools (search_catalog,
# get_product). Legacy endpoint: tools listed in celigo_mcp.legacy_tools
# (search_shop_policies_and_faqs) which are JWT-gated on the UCP route.
CELIGO_MCP_ENDPOINT=https://api.integrator.io/apis/v1/api/ucp/mcp
CELIGO_LEGACY_ENDPOINT=https://api.integrator.io/apis/v1/api/mcp
CELIGO_BEARER_TOKEN=replace-me
# Tool name is a variable — any Celigo MCP tool can be probed:
CELIGO_TOOL_NAME=search_shop_policies_and_faqs
CELIGO_TOOL_ARGUMENTS={"query": "what is your shipping policy"}